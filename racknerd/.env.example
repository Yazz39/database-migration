# Copy to .env and fill in. .env is gitignored -- never commit real values.
#
# Full client API endpoint from your SolusVM control panel. Usually:
#   https://<your-solusvm-panel-host>/api/client/command.php
# Some SolusVM installs expose the client API on port 5656:
#   https://<your-solusvm-panel-host>:5656/api/client/command.php
# The exact host is in your RackNerd welcome email ("VPS Control Panel").
RACKNERD_API_URL=https://your-panel-host.example.com/api/client/command.php

# SolusVM panel -> your VPS -> API tab -> Enable API access
RACKNERD_API_KEY=your-api-key-here
RACKNERD_API_HASH=your-api-hash-here
